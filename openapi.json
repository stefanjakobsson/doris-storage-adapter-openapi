  "components": {
    "schemas": {
      "AccessRight": {
        "enum": [
          "public",
          "nonPublic"
        ]
      },
      "ConsistencyCheckResult": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            }
          }
        }
      },
      "DatasetAccessMode": {
        "enum": [
          "open",
          "restricted"
        ]
      },
      "DatasetVersionStatus": {
        "enum": [
          "published",
          "withdrawn"
        ]
      },
      "ErrorItem": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "target": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ErrorProblemDetails": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            }
          }
        }
      },
      "File": {
        "required": [
          "contentSize",
          "dateCreated",
          "dateModified",
          "encodingFormat",
          "name",
          "sha256"
        ],
        "type": "object",
        "properties": {
          "contentSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "dateCreated": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dateModified": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "encodingFormat": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ImportFilesRequest": {
        "required": [
          "fromVersion"
        ],
        "type": "object",
        "properties": {
          "fromVersion": {
            "type": "string"
          }
        }
      },
      "PublishRequest": {
        "required": [
          "accessRight",
          "canonicalDoi",
          "doi",
          "publicationDate"
        ],
        "type": "object",
        "properties": {
          "accessRight": {
            "$ref": "#/components/schemas/AccessRight"
          },
          "canonicalDoi": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "publicationDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "SetStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/DatasetVersionStatus"
          }
        }
      },
      "SystemInformation": {
        "required": [
          "allowReadDraftFiles",
          "datasetAccessMode",
          "storageProvider",
          "tenancyEnabled",
          "version"
        ],
        "type": "object",
        "properties": {
          "allowReadDraftFiles": {
            "type": "boolean"
          },
          "datasetAccessMode": {
            "$ref": "#/components/schemas/DatasetAccessMode"
          },
          "storageProvider": {
            "type": "string"
          },
          "tenancyEnabled": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Checks"
